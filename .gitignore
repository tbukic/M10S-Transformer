# Ignore everything — only explicitly allowed files are tracked
*

# Top-level files
!.gitignore
!.python-version
!.env.example
!Dockerfile
!LICENSE
!README.md
!docker-compose.yml
!pyproject.toml
!uv.lock

# .claude/
!.claude/
!.claude/*.md

# .devcontainer/
!.devcontainer/
!.devcontainer/*

# Source
!src/
!src/**/
!src/**/*.py

# Tests
!tests/
!tests/**/
!tests/**/*.py

# Notebooks
!notebooks/
!notebooks/**/
!notebooks/**/*.md
!notebooks/**/*.ipynb

# Reports
!reports/
!reports/**/
!reports/**/*.md
!reports/**/*.tex
!reports/**/*.bib

# Paper
!paper/
!paper/**/
!paper/**/*.tex
!paper/**/*.bib
!paper/**/*.bst
!paper/**/*.sty
!paper/**/*.cls
!paper/**/*.pdf
!paper/**/*.png
!paper/**/*.jpg
!paper/**/Makefile

# Experiments
!experiments/
!experiments/**/
!experiments/**/*.py
!experiments/**/*.json
!experiments/**/*.yaml

# Configs
!configs/
!configs/**/
!configs/**/*.json
!configs/**/*.yaml

# Scripts
!scripts/
!scripts/**/
!scripts/**/*.py

# Data (test sets)
!data/
!data/**/*.json

# Task description
!TASK.md

# Review
!review.md
