# Ignore everything — only explicitly allowed files are tracked
*

# Top-level files
!.gitignore
!.python-version
!.env.example
!Dockerfile
!LICENSE
!README.md
!docker-compose.yml
!pyproject.toml
!uv.lock

# .claude/
!.claude/
!.claude/*.md

# .devcontainer/
!.devcontainer/
!.devcontainer/*

# Source
!src/
!src/**/
!src/**/*.py

# Tests
!tests/
!tests/**/
!tests/**/*.py

# Notebooks
!notebooks/
!notebooks/**/
!notebooks/**/*.md
!notebooks/**/*.ipynb
