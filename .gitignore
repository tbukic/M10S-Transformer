# Ignore everything — only explicitly allowed files are tracked
*

# Top-level files
!.gitignore
!.python-version
!.env.example
!Dockerfile
!LICENSE
!README.md
!docker-compose.yml
!pyproject.toml
!uv.lock

# .claude/
!.claude/
!.claude/*.md

# .devcontainer/
!.devcontainer/
!.devcontainer/*

# Source
!src/
!src/**/
!src/**/*.py

# Tests
!tests/
!tests/**/
!tests/**/*.py

# Notebooks
!notebooks/
!notebooks/**/
!notebooks/**/*.md
!notebooks/**/*.ipynb

# Reports
!reports/
!reports/**/
!reports/**/*.md
!reports/**/*.tex
!reports/**/*.bib

# Paper
!paper/
!paper/**/
!paper/**/*.tex
!paper/**/*.bib
!paper/**/*.bst
!paper/**/*.sty
!paper/**/*.cls
!paper/**/*.pdf
!paper/**/*.png
!paper/**/*.jpg
!paper/**/Makefile

# Experiments
!experiments/
!experiments/**/
!experiments/**/*.py
!experiments/**/*.json
!experiments/**/*.yaml
# Archive — old experiments, not needed for reproduction
experiments/archive/

# Configs
!configs/
!configs/**/
!configs/**/*.json
!configs/**/*.yaml

# Checkpoints — best-per-param only (~30KB total)
!checkpoints/
!checkpoints/qwen3_d3_ff2_83p_tiekv_tieqo_shnorm_s905_targeted/
!checkpoints/qwen3_d3_ff2_83p_tiekv_tieqo_shnorm_s905_targeted/*
!checkpoints/qwen3_d3_ff2_86p_tiekv_tieqo_shbnorm_s1_targeted/
!checkpoints/qwen3_d3_ff2_86p_tiekv_tieqo_shbnorm_s1_targeted/*
!checkpoints/qwen3_d3_ff2_89p_tiekv_tieqo_s11127/
!checkpoints/qwen3_d3_ff2_89p_tiekv_tieqo_s11127/*
!checkpoints/qwen3_d3_ff2_101p_tieqo_s13_targeted/
!checkpoints/qwen3_d3_ff2_101p_tieqo_s13_targeted/*
!checkpoints/qwen3_d3_ff3_122p_s6/
!checkpoints/qwen3_d3_ff3_122p_s6/*

# Scripts
!scripts/
!scripts/**/
!scripts/**/*.py

# Data (test sets)
!data/
!data/**/*.json

# Submissions (AdderBoard)
!submissions/
!submissions/**/*.py
!submissions/**/*.md
!submissions/**/*.txt

# AdderBoard verify.py
!verify.py

